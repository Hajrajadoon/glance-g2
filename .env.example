# Copy this file to .env and fill in your keys. NEVER commit .env or share the keys.
# Free option: get GROQ_API_KEY at console.groq.com/keys (AI drafts + voice).
GROQ_API_KEY=
# Optional (paid): if set, Claude writes the drafts instead of Groq.
ANTHROPIC_API_KEY=
PORT=8787

# --- Real Gmail (optional; without it the app uses the demo inbox) ---
# From Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Redirect URI to register there: http://localhost:8787/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 only after you enabled the Google Calendar API and added the calendar.readonly scope. Enables the real meeting brief.
GOOGLE_CALENDAR=0
# Set DEMO=1 to force offline mode (no AI, no voice calls)
DEMO=0
# Optional overrides
# GROQ_MODEL=llama-3.1-8b-instant
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en
